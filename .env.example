# ---- Public (exposed to the browser) ----
# Canonical site origin. Used for canonical tags, sitemap.xml and absolute og:image
# URLs. Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Server only (never exposed) ----
# Stripe secret key
STRIPE_SECRET_KEY=sk_test_...

# HMAC key for order-lookup capability tokens. MUST be independent of
# STRIPE_SECRET_KEY: rotating Stripe should not invalidate outstanding order
# links, and one secret should not serve two purposes.
# Generate with: openssl rand -hex 32
# Signing secret for the Stripe webhook at /api/stripe/webhook. Without it the
# endpoint returns 503 rather than trusting an unverified body. Get it from
# `stripe listen` locally, or the Stripe dashboard for a deployed endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
ORDER_TOKEN_SECRET=

# ---- Local tooling only ----
# Create a GitHub PAT at https://github.com/settings/tokens
# Cloudflare Turnstile. BOTH must be set for bot protection to exist: the
# widget alone protects nothing, and the server half is what rejects a request.
# Until they are set, /api/stripe/create-payment-intent is anonymous and
# unthrottled, which is the shape card-testing abuse looks for.
#
# These are Cloudflare's PUBLISHED always-pass test keys, not secrets, and they
# are what you want locally. A real site key is bound to its domains, so
# dropping the production key in here renders a widget that errors on
# localhost - and the checkout now blocks submit when the widget errors, which
# would leave local development unable to reach payment at all.
#
# Using the test pair locally means the whole path runs in dev exactly as it
# does in production: the widget renders, it is solved, and the server calls
# siteverify. The real keys live in the Vercel project settings and nowhere
# else. Create a real widget at dash.cloudflare.com -> Turnstile.
#   1x...AA pair = always passes.  2x...AB / 2x...AA pair = always blocks,
#   which is how to see the blocked-widget branch without an ad blocker.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Transactional email (Resend). Both must be set or nothing is emailed - the
# quote is still recorded as a draft invoice in Stripe, which is the shop's
# real worklist, so a missing key is a warning rather than a failed order.
# ORDER_FROM_EMAIL must be on a domain verified in Resend (SPF + DKIM).
RESEND_API_KEY=
ORDER_FROM_EMAIL=orders@example.com
# Where "new quote received" lands.
ORDER_NOTIFICATION_EMAIL=support@example.com

GITHUB_TOKEN=ghp_...
# Create a Vercel token at https://vercel.com/account/tokens
VERCEL_TOKEN=...
