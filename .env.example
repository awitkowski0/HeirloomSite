# Required for Vercel deployment
# Set these in Vercel's environment variables dashboard:
# - STRIPE_SECRET_KEY
# - POSTGRES_URL (from Vercel Postgres)

# Required for local development (Vite exposes VITE_* vars to client)
VITE_STRIPE_PUBLIC_KEY=pk_test_...
VITE_POSTHOG_TOKEN=phc_...

# Required for automated PR creation (opencode feature workflow)
# Create a GitHub token at https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=ghp_...
# Create a Vercel token at https://vercel.com/account/tokens
VERCEL_TOKEN=...
