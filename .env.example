# ---- Public (exposed to the browser) ----
# Canonical site origin. Used for canonical tags, sitemap.xml and absolute og:image
# URLs. Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# PostHog. In production HOST is a reverse proxy on our own domain, set in the
# Vercel project settings, because tracker blocklists drop *.posthog.com
# outright. next.config.ts reads the same variable to build the CSP.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Send events from `next dev`. Off by default: dev traffic does not belong in
# the production project, so src/lib/posthog-client.ts opts out whenever
# NODE_ENV is not production. Set this to 1 while working on analytics - it
# opts back in and turns on posthog-js logging, which is the only way to see a
# capture actually leave the browser before shipping it. LOCAL ONLY: it does
# nothing in a production build, and it does not belong in Vercel.
NEXT_PUBLIC_POSTHOG_DEBUG=

# Meta (Facebook) Pixel. PRODUCTION ONLY - set it in the Vercel project
# settings and leave it unset here, in preview and in local dev. Test traffic in
# a pixel does not merely add noise: Meta's optimiser learns from it, so a
# handful of fake conversions teaches the ad delivery to chase people who behave
# like you do while testing. That is slow and expensive to undo. Unset,
# src/lib/meta-pixel.ts loads nothing at all and every metaTrack() is a no-op.
#
# The pixel is loaded LAZILY, by the consent handler - never by the layout. A
# visitor in a consent-required region who has not accepted never fetches
# fbevents.js and never gets an _fbp cookie. next.config.ts names the Meta
# origins in the CSP unconditionally, so the policy is testable without it.
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Server only (never exposed) ----
# Stripe secret key
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for the Stripe webhook at /api/stripe/webhook. Without it the
# endpoint returns 503 rather than trusting an unverified body - so every
# invoice event, including payment confirmations, is dropped. Get it from
# `stripe listen` locally, or the Stripe dashboard for a deployed endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare Turnstile. BOTH must be set for bot protection to exist: the
# widget alone protects nothing, and the server half is what rejects a request.
# Until they are set, /api/quotes is anonymous and unthrottled - and it creates
# Stripe customers and sends mail to an address the caller supplies, which is
# the shape email-bombing abuse looks for.
#
# These are Cloudflare's PUBLISHED always-pass test keys, not secrets, and they
# are what you want locally. A real site key is bound to its domains, so
# dropping the production key in here renders a widget that errors on
# localhost - and the checkout now blocks submit when the widget errors, which
# would leave local development unable to reach payment at all.
#
# Using the test pair locally means the whole path runs in dev exactly as it
# does in production: the widget renders, it is solved, and the server calls
# siteverify. The real keys live in the Vercel project settings and nowhere
# else. Create a real widget at dash.cloudflare.com -> Turnstile.
#   1x...AA pair = always passes.  2x...AB / 2x...AA pair = always blocks,
#   which is how to see the blocked-widget branch without an ad blocker.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Radar address autocomplete on the checkout street field (publishable key,
# public by design - it is sent from the browser). RESTRICT IT TO YOUR DOMAINS
# in the Radar dashboard: the domain allowlist is the only thing stopping
# someone else spending the free tier. Optional; the field is a plain text
# input without it. Free tier is 100k lookups/month.
NEXT_PUBLIC_RADAR_KEY=

# Transactional email (Resend). Both must be set or nothing is emailed - the
# quote is still recorded as a draft invoice in Stripe, which is the shop's
# real worklist, so a missing key is a warning rather than a failed order.
# ORDER_FROM_EMAIL must be on a domain verified in Resend (SPF + DKIM).
RESEND_API_KEY=
# Must be on a domain verified in Resend. Prefer a real mailbox on the apex
# domain (orders@example.com) over a Resend-verified subdomain: MX records do
# not inherit downwards, so nobody can reply to mail sent from send.example.com
# unless ORDER_REPLY_TO points somewhere else. A display name is allowed:
#   ORDER_FROM_EMAIL=Heirloom Cribs <orders@example.com>
ORDER_FROM_EMAIL=orders@example.com
# Where customer replies land. Optional when ORDER_FROM_EMAIL is itself a
# mailbox; REQUIRED when it is not. Shop notifications ignore this - they always
# reply to the buyer.
ORDER_REPLY_TO=
# Where "new quote received" and payment notifications land. Comma-separate for
# more than one; a malformed entry is skipped with a warning naming it rather
# than failing the whole send. ORDER_FROM_EMAIL must be on a domain verified in
# Resend - a free-mail address like @gmail.com cannot be verified and Resend
# answers 403.
ORDER_NOTIFICATION_EMAIL=orders@example.com, shop@example.com

# Resend Audience for the email lead-capture popup. Create one at
# resend.com -> Audiences. Without it POST /api/subscribe answers 503 and the
# popup says so, rather than accepting an address it has nowhere to put.
#
# Note the deliberate difference from the order mail above: THIS ONE CANNOT FAIL
# SOFT. A quote is already a durable draft invoice in Stripe before email is
# attempted, so a failed send loses nothing. Here nothing is durable until
# Resend accepts the contact - so a soft failure would drop the address on the
# floor while telling the visitor they had subscribed.
RESEND_AUDIENCE_ID=

# ---- Local tooling only ----
# Create a GitHub PAT at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...
# Create a Vercel token at https://vercel.com/account/tokens
VERCEL_TOKEN=...
